{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node" },
    { "src": "admin.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/admin/api/(.*)", "dest": "/admin.js" },
    { "src": "/admin(.*)", "dest": "/admin.js" },
    { "src": "/api/(.*)", "dest": "/index.js" },
    { "src": "/(.*)", "dest": "/index.js" }
  ]
}
